# Quiet Accounts: every setting the server reads, grouped. Copy to .env (or paste into your host's secrets) and fill
# in the required ones. Each says whether it's required or optional and what happens without it.
# Lines starting with "# KEY=" are switched off: remove the "# " to set one. Never set a key to nothing by accident:
# KEY= with no value counts as set (and empty).
# Generate a secret with: openssl rand -hex 32


# ── The server ───────────────────────────────────────────────────────────────────────────────────────────────────

# PUBLIC_URL (required): the server's public https address, no trailing slash. Every unsubscribe link, owner link and
# webhook points at it. Without it: http://localhost:8787, and the server refuses to start with real email or texts.
PUBLIC_URL=

# DATABASE_PATH (required): the SQLite file. Keep it on the mounted volume (/data in the Docker image, which sets
# this already). Without it: ./.data/quiet-accounts.db inside the container, wiped on every deploy.
DATABASE_PATH=/data/quiet-accounts.db

# BACKUP_DIR (optional): where the nightly copies of the database go (the newest 14 are kept), e.g. a second volume.
# Without it: a "backups" folder next to the database, on the same volume, which then needs about 16 times the
# database's size.
# BACKUP_DIR=/data/backups

# TRUSTED_PROXY_HOPS (required behind a proxy): how many proxies in front of the server add the caller's address to
# X-Forwarded-For. Usually 1 behind the host's proxy (Fly, Render, Railway, your own Caddy); one more for each proxy
# in front of that (Cloudflare); the host's docs say. Count only proxies every request passes through: if the server's
# port can be reached directly, a caller writes their own address. Without it: 0, the header is ignored, and every
# sign-up looks like it comes from the proxy, so they all share one rate limit.
TRUSTED_PROXY_HOPS=1

# PORT (optional): the port the server listens on. Without it: 8787. Most hosts set it for you.
# PORT=8787


# ── Secrets ──────────────────────────────────────────────────────────────────────────────────────────────────────

# OPERATOR_TOKEN (required): the operator's password for the console and the operator API, at least 12 characters.
# Without it: a public development token, and the server refuses to start with real email or texts.
OPERATOR_TOKEN=

# APP_SECRET (required): signs owner links and encrypts stored Jobber tokens, at least 16 characters. Changing it
# breaks every owner link already sent. Without it: a public development secret, and the server refuses to send.
APP_SECRET=

# WEBHOOK_SECRET (required): the secret part of every inbound webhook URL (Instantly, inbound email, owner texts), at
# least 12 characters. Without it: a public development secret, and the server refuses to send.
WEBHOOK_SECRET=

# ALLOW_DEV_SECRETS (optional, never in production): "true" lets a test box send with the development secrets.
# Without it: off.
# ALLOW_DEV_SECRETS=true


# ── Email to homeowners ──────────────────────────────────────────────────────────────────────────────────────────

# EMAIL_PROVIDER (required): instantly, smtp or log. Without it: log, and notes are only written to the server log.
EMAIL_PROVIDER=instantly

# INSTANTLY_API_KEY (required with instantly): an Instantly API v2 key with webhook access.
# Without it: the server refuses to start with EMAIL_PROVIDER=instantly.
INSTANTLY_API_KEY=

# INSTANTLY_DAILY_LIMIT (optional): the daily sending limit set on each monthly client's campaigns. A one pass's
# campaigns always get 30 a day per inbox, its pace. Without it: none is set, and Instantly's own limits apply.
# INSTANTLY_DAILY_LIMIT=40

# SMTP_URL (required with smtp): e.g. smtps://user:pass@smtp.example.com. Without it: the server refuses to start
# with EMAIL_PROVIDER=smtp.
# SMTP_URL=

# SMTP_FROM (optional): the From address for SMTP mail when a client has no sending address of its own.
# Without it: every note for such a client fails.
# SMTP_FROM=

# MAIL_CHECK (optional): on or off. Before sending, check that each address's domain takes mail (a DNS lookup).
# Without it: on.
# MAIL_CHECK=on


# ── Texts to owners ──────────────────────────────────────────────────────────────────────────────────────────────

# SMS_PROVIDER (optional): manual, twilio or log. manual: every owner text waits in the console's "Texts to send"
# list for Jack to text by hand, and owner replies are pasted on the client's page. Without it: manual on a server
# with production secrets (until Twilio clears carrier registration), log in development (only the server log).
SMS_PROVIDER=manual

# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN and TWILIO_FROM (required with twilio): the account, its auth token (it also
# checks the signature on every incoming text) and the number texts come from, as +1XXXXXXXXXX.
# Without them: the server refuses to start with SMS_PROVIDER=twilio.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# AUTO_SEND_BILLING_TEXTS (optional): "true" sends texts about money without the operator's OK.
# Without it: false, and every money text waits in the console for the operator (keep it that way).
# AUTO_SEND_BILLING_TEXTS=false

# SLA_FIRST_NUDGE_HOURS (optional): hours a hot reply can wait on the owner before the first reminder.
# Without it: 4.
# SLA_FIRST_NUDGE_HOURS=4


# ── Billing (Stripe) ─────────────────────────────────────────────────────────────────────────────────────────────

# STRIPE_SECRET_KEY (optional): sk_test_... or sk_live_... A one pass's first $250 goes by a /pay link that saves the
# owner's card, and the later ones on that card, each one business day after its text (approved by the operator)
# reaches the owner. The health page shows the mode, never the key. Without it: billing by hand: each approved charge waits in Needs a person ("Send the $250 link"
# or "Charge his saved card") with a Done button, and there are no /pay links.
# STRIPE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET (required with a key): the whsec_... signing secret of the endpoint PUBLIC_URL/webhooks/stripe.
# Without it: a server with production secrets and a key refuses to start (no payment would ever be seen).
# STRIPE_WEBHOOK_SECRET=

# STRIPE_ALLOW_LIVE (optional): "true" allows a live key (sk_live_, rk_live_), which charges real cards. Set it at
# deploy, on purpose. Without it: false, and the server refuses to start with a live key.
# STRIPE_ALLOW_LIVE=true


# ── Sign-ups from the site ───────────────────────────────────────────────────────────────────────────────────────

# SIGNUP_ORIGINS (required while sign-ups are on): comma-separated site origins allowed to post the Start form, e.g.
# https://quietaccounts.com,https://www.quietaccounts.com. Without it: any site can post it.
SIGNUP_ORIGINS=

# SIGNUPS (optional): on or off. Without it: on.
# SIGNUPS=on

# SIGNUPS_PER_HOUR (optional): new sign-ups the whole server takes in an hour, on top of five tries an hour per caller.
# Without it: 30.
# SIGNUPS_PER_HOUR=30


# ── Inbound email ────────────────────────────────────────────────────────────────────────────────────────────────

# INBOUND_DOMAIN (optional): the domain your inbound email service receives on. Owners forward their exports to
# import+<token>@ it, and the service posts each email to PUBLIC_URL/webhooks/inbound-email/WEBHOOK_SECRET.
# Without it: no import addresses; files come in through the console or the site.
# INBOUND_DOMAIN=in.example.com


# ── Claude ───────────────────────────────────────────────────────────────────────────────────────────────────────

# ANTHROPIC_API_KEY (optional): Claude reads the replies the rules can't, maps odd export columns and can personalize
# first notes. Without it: rules only, and anything they can't read goes to a person.
# ANTHROPIC_API_KEY=

# CLAUDE_MODEL (optional): the model it uses. Without it: claude-opus-5-5.
# CLAUDE_MODEL=claude-opus-5-5

# AI_WRITER (optional): on lets Claude personalize first notes (each still passes the quality check).
# Without it: off, and every note is the written template.
# AI_WRITER=off


# ── Jobber (exports only for now; keep these off) ────────────────────────────────────────────────────────────────

# JOBBER_CLIENT_ID and JOBBER_CLIENT_SECRET (optional): the Jobber app's credentials, for connect links and sync.
# Its OAuth callback is PUBLIC_URL/oauth/jobber/callback and its webhook PUBLIC_URL/webhooks/jobber.
# Without them: no Jobber connection; owners send exports.
# JOBBER_CLIENT_ID=
# JOBBER_CLIENT_SECRET=

# JOBBER_READ (optional): what to read besides clients and quotes: any of jobs, invoices, requests (comma-separated),
# only once the app's scopes include it. Without it: clients and quotes only.
# JOBBER_READ=

# JOBBER_WRITE_NOTES (optional): on leaves a note on the Jobber quote when someone replies or books (needs a write
# scope). Without it: off.
# JOBBER_WRITE_NOTES=off


# ── The worker (sending, reminders, reports, backups) ────────────────────────────────────────────────────────────

# WORKER_ENABLED (optional): "false" runs the web server alone. Without it: true. Run exactly one worker per
# database: two would send the same notes twice.
# WORKER_ENABLED=true

# WORKER_INTERVAL_MS (optional): how often the worker ticks. Without it: 60000 (a minute).
# WORKER_INTERVAL_MS=60000

# WORKER_BUSINESS_BUDGET_MS (optional): how long one client's turn may hold up a tick before the worker moves on.
# Without it: 20000.
# WORKER_BUSINESS_BUDGET_MS=20000


# ── Switched-off features ────────────────────────────────────────────────────────────────────────────────────────

# FEATURE_NEW_REQUESTS (optional): on answers new requests (the requests+ addresses, the instant campaign, the
# always-on track). Without it: off, and an inbound email goes to the review queue as plain mail. Leave it off.
# FEATURE_NEW_REQUESTS=off

# FEATURE_YEARLY (optional): on brings back the yearly plan, RENEW/YEARLY, the renewal ask and UNDO after a CANCEL.
# Without it: off. Leave it off.
# FEATURE_YEARLY=off


# ── The console build (not read by the server) ───────────────────────────────────────────────────────────────────

# VITE_API_BASE (optional, build time): the server's address when the console is served from somewhere else.
# Without it: the console calls the server it's served from (the Docker image serves both).
# VITE_API_BASE=
